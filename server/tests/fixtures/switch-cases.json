{
  "_doc": "Run by server/tests/test_switching.py and hosted/test/switch.test.ts, which read it the same way and fill in nothing. A table in \"tables\" may name another in \"extends\": it is that table with its own fields laid over it, each field replacing the base's whole (\"species\" is never merged). A push in a queued item that lacks \"note\" or \"first_days\" means null. \"expect\": null on a parse case is a body that is not a detection.",
  "parse": [
    {"name": "BirdNET-Go's default body",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius",
              "confidence": 0.91, "note_id": 8812, "days_since_first_seen": 267}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.91,
                "note": "8812", "first_days": 267}},
    {"name": "a note_id as a string",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "Blue Jay", "scientific_name": "Cyanocitta cristata",
              "confidence": "0.8", "note_id": " 77 "}},
     "expect": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 0.8, "note": "77", "first_days": null}},
    {"name": "a warning on the same channel",
     "kind": "birdnet_go", "body": {"type": "warning", "title": "Stream disconnected"}, "expect": null},
    {"name": "BirdNET-Go's Test button",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "Testus", "scientific_name": "Testus birdicus", "confidence": 1}},
     "expect": null},
    {"name": "Apprise with text around the JSON",
     "kind": "apprise",
     "body": {"title": "x", "message": "New: {\"comname\": \"Blue Jay\", \"sciname\": \"Cyanocitta cristata\", \"confidence\": 0.75} heard"},
     "expect": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 0.75, "note": null, "first_days": null}},
    {"name": "a confidence out of range is 0",
     "kind": "apprise", "body": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 7},
     "expect": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 0.0, "note": null, "first_days": null}},
    {"name": "a confidence that is true is 0",
     "kind": "apprise", "body": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": true},
     "expect": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 0.0, "note": null, "first_days": null}},
    {"name": "a confidence that is null is 0",
     "kind": "apprise", "body": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": null},
     "expect": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 0.0, "note": null, "first_days": null}},
    {"name": "a confidence written in hex is 0",
     "kind": "apprise", "body": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": "0x1"},
     "expect": {"common": "Blue Jay", "scientific": "Cyanocitta cristata", "confidence": 0.0, "note": null, "first_days": null}},
    {"name": "a name that is not a string is skipped",
     "kind": "apprise", "body": {"comname": ["x"], "common": "Blue Jay", "sciname": 5},
     "expect": {"common": "Blue Jay", "scientific": "", "confidence": 0.0, "note": null, "first_days": null}},
    {"name": "no name at all",
     "kind": "apprise", "body": {"confidence": 0.9}, "expect": null},
    {"name": "names are trimmed",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "  American Robin ", "scientific_name": "\tTurdus migratorius\n", "confidence": 0.9}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "a name over 200 characters is cut to 200, then left as cut",
     "kind": "apprise",
     "body": {"common": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx yyyyyyyyyy", "scientific": "Turdus migratorius", "confidence": 0.9},
     "expect": {"common": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx ", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "a note_id over 40 characters is cut to 40",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "note_id": "12345678901234567890123456789012345678901234567890"}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": "1234567890123456789012345678901234567890", "first_days": null}},
    {"name": "a note_id of 0 is a note",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "note_id": 0}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": "0", "first_days": null}},
    {"name": "a blank note_id is no note",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "note_id": "   "}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "a note_id that is true is no note",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "note_id": true}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "days since first seen of 99999 is kept",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "days_since_first_seen": 99999}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": 99999}},
    {"name": "days since first seen of 100000 is dropped",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "days_since_first_seen": 100000}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "days since first seen below 0 is dropped",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "days_since_first_seen": -1}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "days since first seen that is true is dropped",
     "kind": "birdnet_go",
     "body": {"type": "detection", "metadata": {"species": "American Robin", "scientific_name": "Turdus migratorius", "confidence": 0.9, "days_since_first_seen": true}},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "an Apprise message with a malformed span reads the top-level fields",
     "kind": "apprise",
     "body": {"message": "New: {not json} heard", "comname": "American Robin", "sciname": "Turdus migratorius", "confidence": 0.9},
     "expect": {"common": "American Robin", "scientific": "Turdus migratorius", "confidence": 0.9, "note": null, "first_days": null}},
    {"name": "a JSON array is not a detection (Apprise)",
     "kind": "apprise",
     "body": [{"comname": "American Robin"}],
     "expect": null},
    {"name": "a JSON array is not a detection (BirdNET-Go)",
     "kind": "birdnet_go",
     "body": [{"type": "detection"}],
     "expect": null},
    {"name": "a string is not a detection (Apprise)",
     "kind": "apprise",
     "body": "American Robin",
     "expect": null},
    {"name": "a string is not a detection (BirdNET-Go)",
     "kind": "birdnet_go",
     "body": "American Robin",
     "expect": null}
  ],
  "choose": [
    {"name": "an empty batch changes nothing", "table": "base", "queued": [], "expect": "same"},
    {"name": "a species with an entry is switched to",
     "table": "base", "queued": [{"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9}}],
     "expect": "turdus migratorius"},
    {"name": "a species with no entry wakes the server",
     "table": "base", "queued": [{"push": {"scientific": "Sitta carolinensis", "common": "White-breasted Nuthatch", "confidence": 0.9}}],
     "expect": "wake"},
    {"name": "a species new today wakes the server",
     "table": "base", "queued": [{"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9, "first_days": 0}}],
     "expect": "wake"},
    {"name": "a blocked species is dropped",
     "table": "base", "queued": [{"push": {"scientific": "Passer domesticus", "common": "House Sparrow", "confidence": 0.9}}],
     "expect": "same"},
    {"name": "below the floor is dropped",
     "table": "floor", "queued": [{"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.5}}],
     "expect": "same"},
    {"name": "first today beats a newer repeat",
     "table": "base", "queued": [
       {"push": {"scientific": "Poecile atricapillus", "common": "Black-capped Chickadee", "confidence": 0.9}},
       {"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9}}],
     "expect": "poecile atricapillus"},
    {"name": "a species heard twice since the take is a repeat, so the newest wins",
     "table": "base", "queued": [
       {"push": {"scientific": "Poecile atricapillus", "common": "Black-capped Chickadee", "confidence": 0.9}},
       {"marker": true},
       {"push": {"scientific": "Poecile atricapillus", "common": "Black-capped Chickadee", "confidence": 0.9}},
       {"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9}}],
     "expect": "turdus migratorius"},
    {"name": "only the batch after the last marker is chosen from",
     "table": "base", "queued": [
       {"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9}},
       {"marker": true}],
     "expect": "same"},
    {"name": "a repeated note_id counts once",
     "table": "base", "queued": [
       {"push": {"scientific": "Poecile atricapillus", "common": "Black-capped Chickadee", "confidence": 0.9, "note": "5"}},
       {"push": {"scientific": "Poecile atricapillus", "common": "Black-capped Chickadee", "confidence": 0.9, "note": "5"}}],
     "expect": "poecile atricapillus"},
    {"name": "a note the server already took is dropped",
     "table": "base", "queued": [{"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9, "note": "8812"}}],
     "expect": "same"},
    {"name": "a push with only a common name wakes the server, though one entry has it",
     "table": "base", "queued": [{"push": {"scientific": "", "common": "American Robin", "confidence": 0.9}}],
     "expect": "wake"},
    {"name": "the species shown, clean, is the same",
     "table": "base", "queued": [{"push": {"scientific": "Haemorhous mexicanus", "common": "House Finch", "confidence": 0.9}}],
     "expect": "same"},
    {"name": "the species shown under a footnote is switched to its own clean sheet",
     "table": "noted", "queued": [{"push": {"scientific": "Haemorhous mexicanus", "common": "House Finch", "confidence": 0.9}}],
     "expect": "haemorhous mexicanus"},
    {"name": "a push with only a common name wakes the server, though two entries share it",
     "table": "twins", "queued": [{"push": {"scientific": "", "common": "American Robin", "confidence": 0.9}}],
     "expect": "wake"},
    {"name": "a push with only a common name wakes the server, and no entry has it",
     "table": "base", "queued": [{"push": {"scientific": "", "common": "White-breasted Nuthatch", "confidence": 0.9}}],
     "expect": "wake"},
    {"name": "a confidence equal to the floor is kept",
     "table": "floor", "queued": [{"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.7}}],
     "expect": "turdus migratorius"},
    {"name": "a species blocked by its common name alone is dropped",
     "table": "blocked_common", "queued": [{"push": {"scientific": "Passer domesticus", "common": "House Sparrow", "confidence": 0.9}}],
     "expect": "same"},
    {"name": "a species blocked by its scientific name alone is dropped",
     "table": "blocked_scientific", "queued": [{"push": {"scientific": "Passer domesticus", "common": "House Sparrow", "confidence": 0.9}}],
     "expect": "same"},
    {"name": "a species first seen days ago does not wake the server",
     "table": "base", "queued": [{"push": {"scientific": "Turdus migratorius", "common": "American Robin", "confidence": 0.9, "first_days": 3}}],
     "expect": "turdus migratorius"}
  ],
  "tables": {
    "base": {"valid_until": 9999999999, "shown": "haemorhous mexicanus", "shown_clean": true,
             "blocked": ["house sparrow", "passer domesticus"], "floor": 0.0, "notes": ["8812"],
             "species": {
               "haemorhous mexicanus": {"common": "house finch", "first_today": false, "etag": "e1", "frames": {}, "viewers": {}},
               "turdus migratorius": {"common": "american robin", "first_today": false, "etag": "e2", "frames": {}, "viewers": {}},
               "poecile atricapillus": {"common": "black-capped chickadee", "first_today": true, "etag": "e3", "frames": {}, "viewers": {}}}},
    "floor": {"extends": "base", "floor": 0.7},
    "noted": {"extends": "base", "shown_clean": false},
    "blocked_common": {"extends": "base", "blocked": ["house sparrow"]},
    "blocked_scientific": {"extends": "base", "blocked": ["passer domesticus"]},
    "twins": {"extends": "base", "species": {
      "haemorhous mexicanus": {"common": "house finch", "first_today": false, "etag": "e1", "frames": {}, "viewers": {}},
      "turdus migratorius": {"common": "american robin", "first_today": false, "etag": "e2", "frames": {}, "viewers": {}},
      "turdus migratorius achrusterus": {"common": "american robin", "first_today": false, "etag": "e4", "frames": {}, "viewers": {}}}}
  }
}
