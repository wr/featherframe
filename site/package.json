{
  "name": "featherframe-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test:unit": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "posters": "npm run build && node scripts/posters.mjs",
    "wall": "npm run build && node scripts/wall.mjs",
    "deploy": "npm run build && wrangler deploy",
    "og": "npm run build && node scripts/og.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.185.4",
    "esbuild": "^0.25.0",
    "wrangler": "^4.40.0"
  }
}
