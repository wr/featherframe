# Every response: HTTPS only, no sniffing, no framing, a quiet referrer, no device features. The CSP starts in
# report-only (three.js loads its textures from blob: URLs; Cloudflare's zone injects its Web Analytics beacon).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob:; media-src 'self'; font-src 'self'; connect-src 'self' blob: https://app.featherframe.app https://cloudflareinsights.com; form-action 'self' https://app.featherframe.app; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# img/, audio/ and video/ keep their names when they change, so a browser asks again each time (a 304 when
# nothing changed); models/ and the bundle's chunks are named by content (build.mjs, esbuild), fonts never change.
/choreo-*.js
  Cache-Control: public, max-age=31536000, immutable
/chunk-*.js
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, no-cache
/audio/*
  Cache-Control: public, no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/video/*
  Cache-Control: public, no-cache
