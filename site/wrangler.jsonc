// featherframe.app, the marketing site: the apex and www (www redirects to the
// apex in src/worker.ts); workers.dev stays on as a preview.
{
  "name": "featherframe-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "featherframe.app", "custom_domain": true },
    { "pattern": "www.featherframe.app", "custom_domain": true },
    // The zone also routes *.featherframe.app/* to featherframe-hosted, which
    // wins over a custom domain; this more specific route sends www here.
    { "pattern": "www.featherframe.app/*", "zone_name": "featherframe.app" }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
